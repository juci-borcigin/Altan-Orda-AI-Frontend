# --- Google OAuth（この3つと許可メールが揃うと保護が有効。未設定なら従来どおり公開 + 任意 Basic）
AUTH_SECRET=
# 本番では必須（例: openssl rand -base64 32）

AUTH_URL=
# 例: http://localhost:3000 または https://xxxx.vercel.app

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# カンマ区切りで複数可。本番では必ず自分のアドレスを入れること。
ALLOWED_GOOGLE_EMAILS=

# --- 任意: Basic（OAuth 未設定時のみ有効）
# BASIC_AUTH_USER=
# BASIC_AUTH_PASS=

# --- API（チャット）任意: 同一 assistant ラウンドあたりの web_search（Tavily）呼び出し上限。未設定時はサーバー既定（例: 4）。
# Sonnet を安定寄りに締めるなら 3 が無難（過検索・ツール過多による失敗を抑える）。
# AO_WEB_SEARCH_MAX_PER_ROUND=

# --- Qdrant（典籍 kind=books。Cluster 名はコンソール上の ao_rag 等）
# QDRANT_URL=https://xxxxxxxx.aws.cloud.qdrant.io:6333
# QDRANT_API_KEY=
# QDRANT_COLLECTION=ao_rag
# QDRANT_HYBRID_COLLECTION=ao_rag_hybrid

# --- LLM（チャット）
# OpenRouter 互換（既定）。直結は model_id の vendor プレフィックス + 各 API キーで自動選択。
# LLM_API_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=
# LLM_MODEL=google/gemini-2.5-flash
# OPENAI_API_KEY=          # openai/* 直結 or RAG embedding
# GEMINI_API_KEY=          # google/* 直結（AI Studio の Gemini API キー。推奨）
# GOOGLE_API_KEY=          # 上記の別名（どちらか一方で可）
# ANTHROPIC_API_KEY=       # anthropic/* 直結
# AO_LLM_FORCE_OPENROUTER=1  # 常に OpenRouter 経由（fallback 試行時など）

# --- Supabase（Storage 添付・DB）
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# AO_ATTACHMENT_MAX_MB=4
# AO_ATTACHMENT_MAX_BYTES=4194304

# --- 講習メーカー（モデル切替は env。UI プルダウンは当面なし）
# AO_COURSE_DEV_MODE=1          # Dev トレース UI・部分生成（本番は 0）
# AO_COURSE_OUTLINE_MODEL=openai/gpt-5.6-terra  # A 講座構成
# AO_COURSE_SESSION_MODEL=openai/gpt-5.6-luna   # B 1回分の本文＋画像プロンプト
# AO_COURSE_IMAGE_MODEL=gpt-image-2
# AO_COURSE_IMAGE_QUALITY=low
# AO_COURSE_IMAGE_SIZE=2048x1152   # 16:9 近傍（gpt-image-2）
# AO_COURSE_CHAT_MODEL=anthropic/claude-sonnet-4.6
# AO_COURSE_IMAGE_USD_PER_IMAGE=   # 任意: 1枚あたり USD を固定上書き
# AO_MOCK_LLM=0                 # 1 で LLM なしモック

# --- Sample ラボ（Preview 閲覧 / 課金ガード）
# AO_SAMPLE_PUBLIC=1            # /sample と GET /api/sample/* を OAuth/Basic 外で公開（Preview 向け）
# AO_SAMPLE_API_SECRET=         # POST /api/sample/* に x-ao-sample-secret 必須。Vercel では未設定だと POST 拒否
# AO_SAMPLE_API_DISABLED=0      # 1 で Sample POST を全面拒否
