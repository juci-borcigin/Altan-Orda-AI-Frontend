# --- Google OAuth（この3つと許可メールが揃うと保護が有効。未設定なら従来どおり公開 + 任意 Basic）
AUTH_SECRET=
# 本番では必須（例: openssl rand -base64 32）

AUTH_URL=
# 例: http://localhost:3000 または https://xxxx.vercel.app

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# カンマ区切りで複数可。本番では必ず自分のアドレスを入れること。
ALLOWED_GOOGLE_EMAILS=

# --- 任意: Basic（OAuth 未設定時のみ有効）
# BASIC_AUTH_USER=
# BASIC_AUTH_PASS=

# --- API（チャット）任意: 同一 assistant ラウンドあたりの web_search（Tavily）呼び出し上限。未設定時はサーバー既定（例: 4）。
# Sonnet を安定寄りに締めるなら 3 が無難（過検索・ツール過多による失敗を抑える）。
# AO_WEB_SEARCH_MAX_PER_ROUND=
