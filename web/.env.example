# --- Google OAuth（この3つと許可メールが揃うと保護が有効。未設定なら従来どおり公開 + 任意 Basic）
AUTH_SECRET=
# 本番では必須（例: openssl rand -base64 32）

AUTH_URL=
# 例: http://localhost:3000 または https://xxxx.vercel.app

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# カンマ区切りで複数可。本番では必ず自分のアドレスを入れること。
ALLOWED_GOOGLE_EMAILS=

# --- 任意: Basic（OAuth 未設定時のみ有効）
# BASIC_AUTH_USER=
# BASIC_AUTH_PASS=

# --- API（チャット）任意: 同一 assistant ラウンドあたりの web_search（Tavily）呼び出し上限。未設定時はサーバー既定（例: 4）。
# Sonnet を安定寄りに締めるなら 3 が無難（過検索・ツール過多による失敗を抑える）。
# AO_WEB_SEARCH_MAX_PER_ROUND=

# --- Qdrant（典籍 kind=books。Cluster 名はコンソール上の ao_rag 等）
# QDRANT_URL=https://xxxxxxxx.aws.cloud.qdrant.io:6333
# QDRANT_API_KEY=
# QDRANT_COLLECTION=ao_rag
# QDRANT_HYBRID_COLLECTION=ao_rag_hybrid

# --- LLM（チャット）脱 OpenRouter: 常時直結。例外は AO_LLM_FORCE_OPENROUTER=1 のみ
# LLM_MODEL=openai/gpt-5.4-mini
# OPENAI_API_KEY=          # openai/* 直結・RAG embedding
# ANTHROPIC_API_KEY=       # anthropic/* 直結（要約既定 Haiku 含む）
# GEMINI_API_KEY=          # google/* 直結（常用外。互換 GOOGLE_API_KEY）
# XAI_API_KEY=             # xai/grok-* 試験
# DEEPSEEK_API_KEY=        # deepseek/* 試験
# PERPLEXITY_API_KEY=      # perplexity/sonar* 試験（Sonar 選択時は Tavily 無効）
# AO_SUMMARY_MODEL=anthropic/claude-haiku-4.5
# AO_LLM_FORCE_OPENROUTER=1  # 例外時のみ OR 強制（常用しない）
# LLM_API_BASE_URL=https://openrouter.ai/api/v1  # FORCE 時のみ使用
# LLM_API_KEY=             # FORCE 時の OR キー
# TAVILY_API_KEY=          # web_search ツール（Sonar モデル時は自動オフ）

# --- Supabase（Storage 添付・DB）
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# AO_ATTACHMENT_MAX_MB=4
# AO_ATTACHMENT_MAX_BYTES=4194304

# --- 講習メーカー（Format v2: Web記事。モデルは調査結論どおり）
# AO_COURSE_DEV_MODE=1          # Dev トレース UI・部分生成（本番は 0）
# AO_COURSE_OUTLINE_MODEL=openai/gpt-5.6-terra  # 構成・指示文
# AO_COURSE_SESSION_MODEL=openai/gpt-5.6-luna   # 本文執筆（FB は Terra）
# AO_COURSE_IMAGE_MODEL=gpt-image-2             # 回メイン画像のみ生成
# AO_COURSE_IMAGE_QUALITY=low
# AO_COURSE_IMAGE_SIZE=2048x1152   # 16:9 近傍（gpt-image-2）
# セクション画像はネット取得（非生成）。1回=5000字固定・回数4〜10 — docs/course-maker/AO_Course_Format_v2.md
# AO_COURSE_CHAT_MODEL=openai/gpt-5.6-terra
# AO_COURSE_IMAGE_USD_PER_IMAGE=   # 任意: 1枚あたり USD を固定上書き
# AO_COURSE_PUBLIC_LEARN_IDS=      # カンマ区切り courseId。/l/{id} 公開受講の allowlist（空なら全部 404）
# AO_COURSE_PUBLIC_LEARN_ORIGIN=  # 共有用絶対URLのオリジン（例: https://altan-orda-ai-frontend.vercel.app）
# AO_MOCK_LLM=0                 # 1 で LLM なしモック

# --- Lab（実験室 /lab — 旧 Sample）。Preview 閲覧 / 課金ガード
# AO_LAB_PUBLIC=1               # /lab と GET /api/lab/* を OAuth/Basic 外で公開（Preview 向け）
# AO_LAB_API_SECRET=            # POST /api/lab/* に x-ao-lab-secret 必須。Vercel では未設定だと POST 拒否
# AO_LAB_API_DISABLED=0         # 1 で Lab POST を全面拒否
# 互換（デュアルリード）: AO_SAMPLE_PUBLIC / AO_SAMPLE_API_SECRET / AO_SAMPLE_API_DISABLED / x-ao-sample-secret
