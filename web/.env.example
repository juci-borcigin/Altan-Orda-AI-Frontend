# =============================================================================
# Altan Orda（web）環境変数の雛形
# -----------------------------------------------------------------------------
# 運用: 日常はローカル（npm run dev）で確認 → 問題なければ git push（Vercel が拾う）
# このファイルは Git に含める（秘密は入れない）。実値は web/.env にだけ書く。
#
# ローカルでクレジットを使わずにチャット経路を試す:
#   AO_LLM_DRY_RUN=1  （外部 LLM は呼ばない）
# 実 LLM（OpenRouter）で試す:
#   LLM_API_* を有効化し、AO_LLM_DRY_RUN は 0 または行ごと削除
# =============================================================================

# --- OpenRouter（チャット推奨。3つそろうと OpenRouter 経由になる）---
# LLM_API_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=
# LLM_MODEL=openai/gpt-4.1-mini

# OpenRouter 向け HTTP-Referer（任意だが推奨）
# OPENROUTER_SITE_URL=https://（本番またはプレビューの Vercel URL）

# --- OpenAI（後方互換の直チャット / Step7 RAG の embeddings text-embedding-3-small。LLM_API_KEY＝OpenRouter とは別キー推奨）---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# OPENAI_API_BASE_URL=https://api.openai.com/v1

# --- 使用量の概算 USD ---
# OpenRouter 経由で model_id が https://openrouter.ai/api/v1/models に載っている場合、
# サーバが自動でトークン単価を取得しモデルごとに USD を算出する（既定で一覧は約1時間キャッシュ）。
# AO_OPENROUTER_PRICING_TTL_SEC=3600
#
# 一覧に無いモデル／フェッチ失敗時のフォールバック（任意・単位は $ / 100万トークン）
# AO_USD_PER_MTOK_PROMPT=0.15
# AO_USD_PER_MTOK_COMPLETION=0.60
#
# ツールチップのみサーバと別ソースで補う場合（ブラウザに埋めるので公開してよい単価のみ）
# NEXT_PUBLIC_AO_USD_PER_MTOK_PROMPT=0.15
# NEXT_PUBLIC_AO_USD_PER_MTOK_COMPLETION=0.60

# --- Tavily（任意。未設定なら web_search ツールは付与されない）---
TAVILY_API_KEY=

# --- /api/chat: LLM・Tavily のタイムアウト（ミリ秒）。既定 120000。ツール検索→再応答で長めが無難（サーバレス上限より長くしないこと）---
# AO_CHAT_REQUEST_TIMEOUT_MS=

# --- /api/chat デバグ（1 で JSON に chatDebug を付与・サーバログに tool 経路を出す）---
# AO_CHAT_DEBUG=

# --- ローカル／検証用（外部 LLM を呼ばない）---
# どちらか一方だけ 1 にするのがおすすめ（両方 1 だとモックが先に効く）
AO_LLM_DRY_RUN=
AO_MOCK_LLM=

# --- LLM リクエスト上限（任意。未設定なら 2048）---
LLM_MAX_TOKENS=
# 完了トークン（max_tokens）の天井。8192 は OpenRouter 等でモデルが拒否することが多い既定 4096。
# モデルが許す場合のみ例: LLM_MAX_TOKENS_CEILING=8192
LLM_MAX_TOKENS_CEILING=

# --- Basic Auth（任意。両方そろうと有効）---
BASIC_AUTH_USER=
BASIC_AUTH_PASS=

# --- 開発のみ（next dev）: LAN の IP で http://<IP>:3000 を開くときの HMR 許可。ホスト名をカンマ区切り（例: 10.164.74.134）---
# ALLOWED_DEV_ORIGINS=

# --- Supabase（Step 4 以降。API ルート等サーバー側のみ。クライアントに含めない）---
# マイグレーション適用後、初回のみシステムプロンプトを DB に載せる場合:
#   cd web && npm run seed:prompts
# （SUPABASE_SERVICE_ROLE_KEY が必要）
# SUPABASE_URL=（Project Settings → API → Project URL）
# SUPABASE_SERVICE_ROLE_KEY=（Legacy の service_role・eyJ で始まる JWT。ダッシュボードの sb_secret_* は不可）

# --- GDrive（web では未使用）---
# 週次バックアップはリポジトリ直下の GitHub Actions のみが GDrive API を使う。
# 必要なシークレットは docs/operations の実装仕様（GDRIVE_* 等）を参照。
